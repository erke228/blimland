# Run `neon env pull` for real values. Never commit .env.local or credentials.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
# Vercel production: postgres / neon / true. Local defaults select Neon when DATABASE_URL is set.
# DATABASE_DRIVER=postgres
# STORAGE_DRIVER=neon
# COOKIE_SECURE=true
# Explicit isolated SQLite mode (omit for the Neon deployment):
# DATABASE_DRIVER=sqlite
# STORAGE_DRIVER=local
# DATABASE_PATH=./data/bilimhub.sqlite
# UPLOAD_DIR=./uploads/materials
# Optional per-course quota for attached video bytes, including removed sections.
# 0 or unset disables the application quota; provider storage limits still apply.
# VIDEO_COURSE_QUOTA_BYTES=0
# Experimental preparation only. Keep false until migration 004 and the full
# signed upload/finalization/cleanup/CORS flow are implemented and verified.
# DIRECT_VIDEO_UPLOAD_ENABLED=false
