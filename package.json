{
  "name": "bilimhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "admin:create": "tsx scripts/admin.ts",
    "preview:setup": "tsx scripts/preview-access.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/check-core.ts",
    "format": "prettier --write src scripts tests next.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src scripts tests next.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
